# Copia este archivo a ~/.config/voza/.env para el modo limpieza en la nube (opcional).
# El STT SIEMPRE corre local. Esto solo afecta la limpieza con IA si no hay Ollama.
# Copy this file to ~/.config/voza/.env for optional cloud cleanup mode.
# STT ALWAYS runs locally. This only affects AI cleanup when Ollama is absent.

# OpenAI-compatible (OpenAI, OpenRouter, Groq, LM Studio...):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Anthropic (opcional / optional):
ANTHROPIC_API_KEY=
CLEANUP_MODEL=gpt-4o-mini
OLLAMA_MODEL=qwen3:8b
